generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum TipoPersonal {
  ADMINISTRATIVO
  ASISTENCIAL
}

enum AplicaA {
  ACTIVO
  CESADO
  TODOS
}

enum TipoDocIdentidad {
  DNI
  CE
}

enum EstadoTrabajador {
  ACTIVO
  CESADO
}

enum Movimiento {
  SIN_MOVIMIENTO
  ROTACION
  DESTAQUE
  ENCARGATURA
  REASIGNACION
}

enum MotivoFin {
  RENUNCIA
  JUBILACION
  FALLECIMIENTO
  FIN_CONTRATO
  DESTITUCION
  OTRA_CAUSA
  RENOVACION
  CAMBIO_REGIMEN
  CAMBIO_CARGO_O_AREA
}

enum NivelAcceso {
  NORMAL
  RESTRINGIDO
  MUY_RESTRINGIDO
}

enum EstadoDocumento {
  PROCESANDO
  DISPONIBLE
  ERROR
  ANULADO
}

enum EstadoLote {
  SUBIENDO
  EN_BANDEJA
  TERMINADO
}

enum EstadoItemLote {
  SUBIENDO
  PENDIENTE
  CLASIFICADO
  DIVIDIDO
  ERROR
}

model Regimen {
  id         Int         @id @default(autoincrement())
  codigo     String      @unique @db.VarChar(20)
  nombre     String      @db.VarChar(80)
  esLaboral  Boolean     @default(true) @map("es_laboral")
  activo     Boolean     @default(true)
  requisitos Requisito[]
  vinculos   Vinculo[]

  @@map("regimen")
}

model Area {
  id       Int       @id @default(autoincrement())
  nombre   String    @db.VarChar(140)
  padreId  Int?      @map("padre_id")
  activo   Boolean   @default(true)
  padre    Area?     @relation("AreaDependencia", fields: [padreId], references: [id], onDelete: Restrict)
  hijas    Area[]    @relation("AreaDependencia")
  vinculos Vinculo[]

  @@map("area")
}

model Cargo {
  id       Int       @id @default(autoincrement())
  nombre   String    @unique @db.VarChar(120)
  activo   Boolean   @default(true)
  vinculos Vinculo[]

  @@map("cargo")
}

model Trabajador {
  id               String           @id @default(uuid()) @db.Uuid
  tipoDocIdentidad TipoDocIdentidad @default(DNI) @map("tipo_doc_identidad")
  numeroDoc        String           @map("numero_doc") @db.VarChar(12)
  apellidoPaterno  String           @map("apellido_paterno") @db.VarChar(80)
  apellidoMaterno  String?          @map("apellido_materno") @db.VarChar(80)
  nombres          String           @db.VarChar(100)
  nombreBusqueda   String?          @map("nombre_busqueda")
  fechaNacimiento  DateTime?        @map("fecha_nacimiento") @db.Date
  sexo             String?          @db.Char(1)
  estadoCivil      String?          @map("estado_civil") @db.VarChar(20)
  direccion        String?          @db.VarChar(200)
  departamento     String?          @db.VarChar(60)
  provincia        String?          @db.VarChar(60)
  distrito         String?          @db.VarChar(60)
  telefono         String?          @db.VarChar(20)
  correo           String?          @db.VarChar(120)
  fechaIngreso     DateTime         @map("fecha_ingreso") @db.Date
  estado           EstadoTrabajador @default(ACTIVO)
  movimientoActual Movimiento       @default(SIN_MOVIMIENTO) @map("movimiento_actual")
  movimientoFecha  DateTime?        @map("movimiento_fecha") @db.Date
  creadoEn         DateTime         @default(now()) @map("creado_en") @db.Timestamptz(3)
  actualizadoEn    DateTime         @updatedAt @map("actualizado_en") @db.Timestamptz(3)
  vinculos         Vinculo[]
  familiares       Familiar[]
  documentos       Documento[]
  auditorias       Auditoria[]
  itemsLote        LoteItem[]

  @@unique([tipoDocIdentidad, numeroDoc], map: "ux_trabajador_doc")
  @@index([estado, movimientoActual], map: "ix_trabajador_estado")
  @@map("trabajador")
}

model Vinculo {
  id           String       @id @default(uuid()) @db.Uuid
  trabajadorId String       @map("trabajador_id") @db.Uuid
  regimenId    Int          @map("regimen_id")
  tipoPersonal TipoPersonal @map("tipo_personal")
  cargoId      Int          @map("cargo_id")
  areaId       Int          @map("area_id")
  fechaInicio  DateTime     @map("fecha_inicio") @db.Date
  fechaFin     DateTime?    @map("fecha_fin") @db.Date
  motivoFin    MotivoFin?   @map("motivo_fin")
  referencia   String?      @db.VarChar(160)
  actual       Boolean      @default(true)
  creadoEn     DateTime     @default(now()) @map("creado_en") @db.Timestamptz(3)
  trabajador   Trabajador   @relation(fields: [trabajadorId], references: [id], onDelete: Restrict)
  regimen      Regimen      @relation(fields: [regimenId], references: [id], onDelete: Restrict)
  cargo        Cargo        @relation(fields: [cargoId], references: [id], onDelete: Restrict)
  area         Area         @relation(fields: [areaId], references: [id], onDelete: Restrict)

  @@index([trabajadorId, fechaInicio(sort: Desc)], map: "ix_vinculo_trabajador")
  @@index([areaId, actual], map: "ix_vinculo_area")
  @@map("vinculo")
}

model Familiar {
  id               String     @id @default(uuid()) @db.Uuid
  trabajadorId     String     @map("trabajador_id") @db.Uuid
  parentesco       String     @db.VarChar(30)
  nombresApellidos String     @map("nombres_apellidos") @db.VarChar(160)
  numeroDoc        String?    @map("numero_doc") @db.VarChar(12)
  fechaNacimiento  DateTime?  @map("fecha_nacimiento") @db.Date
  creadoEn         DateTime   @default(now()) @map("creado_en") @db.Timestamptz(3)
  trabajador       Trabajador @relation(fields: [trabajadorId], references: [id], onDelete: Restrict)

  @@index([trabajadorId], map: "ix_familiar_trabajador")
  @@map("familiar")
}

model Seccion {
  id          Int             @id @default(autoincrement())
  numero      Int             @unique
  nombre      String          @db.VarChar(120)
  carpeta     String          @db.VarChar(80)
  descripcion String
  campos      Json            @default("[]")
  tipos       TipoDocumento[]

  @@map("seccion")
}

model TipoDocumento {
  id               Int         @id @default(autoincrement())
  seccionId        Int         @map("seccion_id")
  codigo           String      @unique @db.Char(4)
  nombre           String      @db.VarChar(200)
  restringido      Boolean     @default(false)
  requiereNumero   Boolean     @default(false) @map("requiere_numero")
  tieneVencimiento Boolean     @default(false) @map("tiene_vencimiento")
  activo           Boolean     @default(true)
  orden            Int         @default(0)
  seccion          Seccion     @relation(fields: [seccionId], references: [id], onDelete: Restrict)
  requisitos       Requisito[]
  documentos       Documento[]
  itemsLote        LoteItem[]

  @@index([seccionId, orden], map: "ix_tipo_documento_seccion")
  @@map("tipo_documento")
}

model Requisito {
  id              Int           @id @default(autoincrement())
  tipoDocumentoId Int           @map("tipo_documento_id")
  regimenId       Int?          @map("regimen_id")
  tipoPersonal    TipoPersonal? @map("tipo_personal")
  aplicaA         AplicaA       @default(TODOS) @map("aplica_a")
  tipoDocumento   TipoDocumento @relation(fields: [tipoDocumentoId], references: [id], onDelete: Restrict)
  regimen         Regimen?      @relation(fields: [regimenId], references: [id], onDelete: Restrict)

  @@map("requisito")
}

model Rol {
  id          String       @id @default(uuid()) @db.Uuid
  nombre      String       @unique @db.VarChar(60)
  descripcion String
  esSistema   Boolean      @default(false) @map("es_sistema")
  usuarios    Usuario[]
  permisos    RolPermiso[]

  @@map("rol")
}

model Permiso {
  codigo      String       @id @db.VarChar(60)
  modulo      String       @db.VarChar(40)
  descripcion String
  roles       RolPermiso[]

  @@map("permiso")
}

model RolPermiso {
  rolId         String  @map("rol_id") @db.Uuid
  permisoCodigo String  @map("permiso_codigo") @db.VarChar(60)
  rol           Rol     @relation(fields: [rolId], references: [id], onDelete: Cascade)
  permiso       Permiso @relation(fields: [permisoCodigo], references: [codigo], onDelete: Restrict)

  @@id([rolId, permisoCodigo])
  @@map("rol_permiso")
}

model Usuario {
  id                    String             @id @default(uuid()) @db.Uuid
  usuario               String             @unique @db.VarChar(30)
  nombreCompleto        String             @map("nombre_completo") @db.VarChar(120)
  correo                String             @unique @db.VarChar(120)
  claveHash             String             @map("clave_hash")
  rolId                 String             @map("rol_id") @db.Uuid
  activo                Boolean            @default(true)
  intentosFallidos      Int                @default(0) @map("intentos_fallidos")
  bloqueadoHasta        DateTime?          @map("bloqueado_hasta") @db.Timestamptz(3)
  debeCambiarClave      Boolean            @default(true) @map("debe_cambiar_clave")
  ultimoAcceso          DateTime?          @map("ultimo_acceso") @db.Timestamptz(3)
  creadoEn              DateTime           @default(now()) @map("creado_en") @db.Timestamptz(3)
  actualizadoEn         DateTime           @updatedAt @map("actualizado_en") @db.Timestamptz(3)
  rol                   Rol                @relation(fields: [rolId], references: [id], onDelete: Restrict)
  auditorias            Auditoria[]
  documentosCreados     Documento[]        @relation("DocumentoCreador")
  documentosModificados Documento[]        @relation("DocumentoModificador")
  archivosSubidos       DocumentoArchivo[]
  lotes                 LoteCarga[]

  @@map("usuario")
}

model Documento {
  id                 String             @id @default(uuid()) @db.Uuid
  trabajadorId       String             @map("trabajador_id") @db.Uuid
  tipoDocumentoId    Int                @map("tipo_documento_id")
  numero             String?            @db.VarChar(60)
  fechaEmision       DateTime?          @map("fecha_emision") @db.Date
  fechaVencimiento   DateTime?          @map("fecha_vencimiento") @db.Date
  emisor             String?            @db.VarChar(160)
  observaciones      String?            @db.VarChar(500)
  ubicacionFisica    String?            @map("ubicacion_fisica") @db.VarChar(120)
  datos              Json               @default("{}")
  nivelAcceso        NivelAcceso        @default(NORMAL) @map("nivel_acceso")
  estado             EstadoDocumento    @default(PROCESANDO)
  detalleError       String?            @map("detalle_error") @db.VarChar(300)
  motivoAnulacion    String?            @map("motivo_anulacion") @db.VarChar(500)
  subidaPendiente    String?            @map("subida_pendiente") @db.VarChar(64)
  archivoActualId    String?            @unique @map("archivo_actual_id") @db.Uuid
  creadoPorId        String             @map("creado_por") @db.Uuid
  creadoEn           DateTime           @default(now()) @map("creado_en") @db.Timestamptz(3)
  modificadoPorId    String?            @map("modificado_por") @db.Uuid
  modificadoEn       DateTime?          @map("modificado_en") @db.Timestamptz(3)
  motivoModificacion String?            @map("motivo_modificacion") @db.VarChar(500)
  loteItemId         String?            @map("lote_item_id") @db.Uuid
  actualizadoEn      DateTime           @updatedAt @map("actualizado_en") @db.Timestamptz(3)
  loteItem           LoteItem?          @relation(fields: [loteItemId], references: [id], onDelete: Restrict)
  trabajador         Trabajador         @relation(fields: [trabajadorId], references: [id], onDelete: Restrict)
  tipoDocumento      TipoDocumento      @relation(fields: [tipoDocumentoId], references: [id], onDelete: Restrict)
  creadoPor          Usuario            @relation("DocumentoCreador", fields: [creadoPorId], references: [id], onDelete: Restrict)
  modificadoPor      Usuario?           @relation("DocumentoModificador", fields: [modificadoPorId], references: [id], onDelete: Restrict)
  archivoActual      DocumentoArchivo?  @relation("ArchivoActual", fields: [archivoActualId], references: [id], onDelete: Restrict)
  archivos           DocumentoArchivo[] @relation("ArchivosDelDocumento")

  @@index([trabajadorId, tipoDocumentoId, fechaEmision], map: "ix_documento_legajo")
  @@index([estado], map: "ix_documento_estado")
  @@index([loteItemId], map: "ix_documento_lote_item")
  @@index([fechaVencimiento], map: "ix_documento_vencimiento")
  @@index([creadoPorId, creadoEn], map: "ix_documento_creado")
  @@map("documento")
}

model LoteCarga {
  id           String     @id @default(uuid()) @db.Uuid
  usuarioId    String     @map("usuario_id") @db.Uuid
  estado       EstadoLote @default(SUBIENDO)
  total        Int
  clasificados Int        @default(0)
  pendientes   Int        @default(0)
  conError     Int        @default(0) @map("con_error")
  creadoEn     DateTime   @default(now()) @map("creado_en") @db.Timestamptz(3)
  terminadoEn  DateTime?  @map("terminado_en") @db.Timestamptz(3)
  usuario      Usuario    @relation(fields: [usuarioId], references: [id], onDelete: Restrict)
  items        LoteItem[]

  @@index([creadoEn], map: "ix_lote_carga_creado")
  @@map("lote_carga")
}

model LoteItem {
  id              String         @id @default(uuid()) @db.Uuid
  loteId          String         @map("lote_id") @db.Uuid
  orden           Int
  nombreArchivo   String         @map("nombre_archivo") @db.VarChar(255)
  tamano          BigInt
  subidaId        String?        @unique @map("subida_id") @db.VarChar(64)
  trabajadorId    String?        @map("trabajador_id") @db.Uuid
  tipoDocumentoId Int?           @map("tipo_documento_id")
  estado          EstadoItemLote @default(SUBIENDO)
  motivo          String?        @db.VarChar(300)
  creadoEn        DateTime       @default(now()) @map("creado_en") @db.Timestamptz(3)
  actualizadoEn   DateTime       @updatedAt @map("actualizado_en") @db.Timestamptz(3)
  lote            LoteCarga      @relation(fields: [loteId], references: [id], onDelete: Restrict)
  trabajador      Trabajador?    @relation(fields: [trabajadorId], references: [id], onDelete: Restrict)
  tipoDocumento   TipoDocumento? @relation(fields: [tipoDocumentoId], references: [id], onDelete: Restrict)
  documentos      Documento[]

  @@unique([loteId, orden], map: "ux_lote_item_orden")
  @@index([estado, actualizadoEn], map: "ix_lote_item_estado")
  @@map("lote_item")
}

model DocumentoArchivo {
  id             String     @id @default(uuid()) @db.Uuid
  documentoId    String     @map("documento_id") @db.Uuid
  version        Int
  ruta           String     @db.VarChar(200)
  nombreOriginal String     @map("nombre_original") @db.VarChar(200)
  tamanoOriginal BigInt     @map("tamano_original")
  tamanoFinal    BigInt     @map("tamano_final")
  hashOriginal   String     @map("hash_original") @db.Char(64)
  hashFinal      String     @map("hash_final") @db.Char(64)
  paginas        Int
  optimizado     Boolean
  subidoPorId    String     @map("subido_por") @db.Uuid
  creadoEn       DateTime   @default(now()) @map("creado_en") @db.Timestamptz(3)
  documento      Documento  @relation("ArchivosDelDocumento", fields: [documentoId], references: [id], onDelete: Restrict)
  actualDe       Documento? @relation("ArchivoActual")
  subidoPor      Usuario    @relation(fields: [subidoPorId], references: [id], onDelete: Restrict)

  @@unique([documentoId, version], map: "ux_documento_archivo_version")
  @@index([hashOriginal], map: "ix_archivo_hash_original")
  @@map("documento_archivo")
}

model Auditoria {
  id           BigInt      @id @default(autoincrement())
  fecha        DateTime    @default(now()) @db.Timestamptz(3)
  usuarioId    String?     @map("usuario_id") @db.Uuid
  accion       String      @db.VarChar(60)
  entidad      String      @db.VarChar(60)
  entidadId    String?     @map("entidad_id") @db.VarChar(60)
  trabajadorId String?     @map("trabajador_id") @db.Uuid
  ip           String?     @db.Inet
  userAgent    String?     @map("user_agent")
  detalle      Json?
  usuario      Usuario?    @relation(fields: [usuarioId], references: [id], onDelete: Restrict)
  trabajador   Trabajador? @relation(fields: [trabajadorId], references: [id], onDelete: Restrict)

  @@index([usuarioId, fecha(sort: Desc)], map: "ix_auditoria_usuario")
  @@index([trabajadorId, fecha(sort: Desc)], map: "ix_auditoria_legajo")
  @@index([accion, fecha(sort: Desc)], map: "ix_auditoria_accion")
  @@map("auditoria")
}
